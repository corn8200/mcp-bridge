{
  "name": "mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persistent local MCP bridge for Overseer and Sentinel.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio-proxy.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/index.ts auth"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
