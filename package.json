{
  "name": "mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OAuth-aware local bridge for Model Context Protocol servers. Warm tool cache, reconnect with backoff, CORS for Claude/ChatGPT origins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/corn8200/mcp-bridge"
  },
  "homepage": "https://github.com/corn8200/mcp-bridge",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "oauth",
    "bridge",
    "stdio",
    "claude",
    "anthropic",
    "chatgpt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "stdio": "node dist/stdio-proxy.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/index.ts auth"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
